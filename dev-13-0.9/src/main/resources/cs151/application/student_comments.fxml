<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml" 
            fx:controller="cs151.application.StudentCommentsController"
            fitToWidth="true">
    <content>
        <VBox spacing="20.0" style="-fx-background-color: #f5f5f5;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <!-- Header -->
            <VBox alignment="CENTER" spacing="10.0">
                <Label fx:id="studentNameLabel" 
                       text="Student Comments"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="View and manage comments for this student" 
                       style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
            </VBox>

            <!-- Main Content -->
            <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 8;">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                </padding>

                <!-- Existing Comments Section -->
                <VBox spacing="10.0">
                    <Label text="Stored Comments" 
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    
                    <ScrollPane fx:id="commentsScrollPane" 
                               fitToWidth="true" 
                               prefHeight="250.0"
                               style="-fx-background-color: #f5f5f5;">
                        <VBox fx:id="commentsContainer" spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                            </padding>
                        </VBox>
                    </ScrollPane>
                </VBox>

                <!-- Add New Comment Section -->
                <VBox spacing="10.0">
                    <Label text="Add New Comment" 
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 20 0 0 0;"/>
                    
                    <Label text="Comment will be automatically stamped with today's date" 
                           style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                    
                    <TextArea fx:id="newCommentField" 
                             promptText="Enter your comment here..."
                             wrapText="true"
                             prefHeight="100.0"/>
                    
                    <Label fx:id="statusLabel" text="" />
                </VBox>

                <!-- Action Buttons -->
                <HBox alignment="CENTER" spacing="20.0">
                    <padding>
                        <Insets top="10.0"/>
                    </padding>
                    
                    <Button fx:id="addCommentBtn" 
                           text="Add Comment" 
                           onAction="#onAddCommentClick"
                           prefWidth="150.0" prefHeight="35.0"
                           style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 5;"/>
                    
                    <Button fx:id="backBtn" 
                           text="Back to Students" 
                           onAction="#onBackClick"
                           prefWidth="150.0" prefHeight="35.0"
                           style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>

