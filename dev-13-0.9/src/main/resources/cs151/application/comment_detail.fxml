<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" 
      fx:controller="cs151.application.CommentDetailController"
      spacing="20.0" 
      style="-fx-background-color: #f5f5f5;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Header -->
    <VBox alignment="CENTER" spacing="10.0">
        <Label text="Comment Detail" 
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Label fx:id="studentNameLabel" 
               text="Comment for: Student Name" 
               style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
    </VBox>

    <!-- Comment Content -->
    <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 8;">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>

        <Label fx:id="dateLabel" 
               text="Date: " 
               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

        <Label text="Full Comment:" 
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <TextArea fx:id="commentTextArea" 
                 wrapText="true" 
                 editable="false"
                 prefHeight="300.0"
                 style="-fx-font-size: 14px;"/>

        <Label fx:id="statusLabel" text="" />
    </VBox>

    <!-- Close Button -->
    <HBox alignment="CENTER">
        <Button fx:id="backBtn" 
               text="Close" 
               onAction="#onBackClick"
               prefWidth="120.0" prefHeight="35.0"
               style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5;"/>
    </HBox>
</VBox>

