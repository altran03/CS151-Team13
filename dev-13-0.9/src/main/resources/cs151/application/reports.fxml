<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml" 
            fx:controller="cs151.application.ReportsController"
            fitToWidth="true">
    <content>
        <VBox spacing="20.0" style="-fx-background-color: #f5f5f5;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <!-- Header -->
            <VBox alignment="CENTER" spacing="10.0">
                <Label text="Student Reports" 
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Generate reports for blacklisted or whitelisted students" 
                       style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
            </VBox>

            <!-- Report Selection -->
            <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 8;">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                </padding>

                <Label text="Select Report Type" 
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <HBox spacing="20.0" alignment="CENTER_LEFT">
                    <RadioButton fx:id="blacklistRadio" text="Blacklisted Students" 
                                toggleGroup="$reportTypeGroup" selected="true"/>
                    <RadioButton fx:id="whitelistRadio" text="Whitelisted Students" 
                                toggleGroup="$reportTypeGroup"/>
                </HBox>

                <HBox spacing="15.0" alignment="CENTER_LEFT">
                    <Button fx:id="generateReportBtn" 
                           text="Generate Report" 
                           onAction="#onGenerateReportClick"
                           prefWidth="150.0" prefHeight="35.0"
                           style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5;"/>
                    
                    <Label fx:id="statusLabel" text="" />
                </HBox>
            </VBox>

            <!-- Results Table -->
            <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8;">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                </padding>

                <Label text="Results (double-click row to view details)" 
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <TableView fx:id="table" prefHeight="300.0">
                    <columns>
                        <TableColumn fx:id="colFullName" text="Full Name" minWidth="100"/>
                        <TableColumn fx:id="colAcademic" text="Academic Status" minWidth="100"/>
                        <TableColumn fx:id="colJob" text="Job Status" minWidth="150"/>
                        <TableColumn fx:id="colLangs" text="Languages" minWidth="100"/>
                        <TableColumn fx:id="colDBs" text="Databases" minWidth="100"/>
                        <TableColumn fx:id="colRole" text="Role" minWidth="80"/>
                        <TableColumn fx:id="colComments" text="Comments" minWidth="200"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Back Button -->
            <HBox alignment="CENTER">
                <Button fx:id="backBtn" 
                       text="Back to Home" 
                       onAction="#onBackClick"
                       prefWidth="150.0" prefHeight="35.0"
                       style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5;"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>

